{
  "name": "cross-paraglide-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Carte 3D interactive des brises et de l'aérologie des Alpes françaises pour le parapente de distance.",
  "scripts": {
    "dev": "npm run dev -w @brises/web",
    "dev:api": "npm run dev -w @brises/api",
    "build": "npm run typecheck && npm run build -w @brises/web && npm run build -w @brises/api",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "data:dem": "tsx scripts/build-dem.ts",
    "data:build": "tsx scripts/build-data.ts",
    "data:airspace": "tsx scripts/build-airspace.ts",
    "data:sites": "tsx scripts/import-sites.ts",
    "e2e": "tsx apps/web/e2e/screenshot.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.4",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright-core": "^1.63.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
