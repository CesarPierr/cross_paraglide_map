# Copy to .env and fill in before `docker compose up`.
POSTGRES_PASSWORD=change-me
# Bearer token for /api/admin/* (moderation of contributions).
ADMIN_TOKEN=change-me-too
# Random string used to hash contributor IPs (rate limiting, abuse).
IP_SALT=random-string
# Allowed browser origins, comma separated (* = any).
CORS_ORIGIN=*
# Open-Meteo calls per day shared by all users (free tier ≈ 10 000).
WEATHER_DAILY_BUDGET=8000
HTTP_PORT=80
LOG_LEVEL=info
